# Copy to .env.local and fill in.

# Must match the keys: block in livekit/livekit.yaml
LIVEKIT_API_KEY=APIyourkeyhere
LIVEKIT_API_SECRET=

# Public URLs, as reached from a browser
LIVEKIT_URL=wss://livekit.example.com
PUBLIC_BASE_URL=https://meet.example.com
WHIP_BASE_URL=https://whip.example.com/w

# Seeds the 'admin' account on first login, then ignored.
# Use something long; it guards room and account creation.
ADMIN_PASSWORD=

# Persistent stores. Keep these on a mounted volume.
ROOM_STORE_PATH=/data/rooms.json
USER_STORE_PATH=/data/users.json
