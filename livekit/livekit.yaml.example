port: 7880

rtc:
  udp_port: 7882
  tcp_port: 7881
  use_external_ip: true
  enable_loopback_candidate: false
  interfaces:
    includes:
      - eth0
  ips:
    excludes:
      - 172.16.0.0/12
      - 100.64.0.0/10

redis:
  address: 127.0.0.1:6379

keys:
  APIyourkeyhere: <YOUR_SECRET>

ingress:
  whip_base_url: https://whip.example.com

room:
  auto_create: true
  empty_timeout: 300
  max_participants: 20

turn:
  enabled: false

logging:
  level: info
  json: false
